bg_color white
set ray_opaque_background, off

set ray_shadow, off
set ambient, 0.6
set two_sided_lighting, on
set ray_trace_fog, 0
set depth_cue, 0

set ray_trace_mode,   1
set ray_trace_gain,   0.04
set ray_trace_color,  black

set antialias, 3
set cartoon_fancy_helices, 1
set cartoon_sampling, 14

set_color pastel_blue,   [0.55, 0.65, 0.85] # #8CA6D9
set_color pastel_pink,   [0.93, 0.75, 0.82] # #EDBFD1
set_color pastel_yellow, [0.98, 0.90, 0.70] # #FAE5B3
set_color pastel_green,  [0.70, 0.85, 0.78] # #B3D9C7
set_color pastel_gray,   [0.86, 0.86, 0.88] # #DBDBDF

set sphere_scale, 0.5