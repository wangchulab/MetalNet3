axes.prop_cycle : "cycler('color', ['#8CA6D9', '#EDBFD1', '#FAE5B3', '#B3D9C7', '#C6CED8', '#F2C6A0'])" # https://colorhunt.co/palettes/pastel

font.family : "Arial"
mathtext.default : "regular"
pdf.fonttype : 42
# ps.fonttype : 42
font.size : 7
axes.titlesize : 7
axes.labelsize : 7
axes.linewidth : 0.5
xtick.major.width : 0.5
xtick.minor.width : 0.5
ytick.major.width : 0.5
ytick.minor.width : 0.5

lines.linewidth : 0.5
patch.linewidth: 0.5